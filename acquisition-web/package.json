    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.1",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
